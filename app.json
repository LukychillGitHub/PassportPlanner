{
  "expo": {
    "name": "PassportPlanner",
    "slug": "PassportPlanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lukychill.passportplanner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECD8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lukychill.passportplanner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PassportPlanner usa tus fotos para tu foto de perfil y para las fotos de las actividades que sellás.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
